{
  "expo": {
    "name": "EduEats Parent",
    "slug": "edueats-parent",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "icon": "./assets/icon-square.png",
    "web": {
      "favicon": "./assets/icon.png"
    },
    "android": {
      "package": "com.edueats.parent",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icon-square.png",
        "backgroundColor": "#E7F8ED"
      }
    },
    "ios": {
      "bundleIdentifier": "com.edueats.parent"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "plugins": [
      "expo-status-bar",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon-square.png",
          "color": "#07804F"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "3530ec56-e1d0-4057-903d-64aaf09dd8c0"
      }
    },
    "owner": "remingan"
  }
}
